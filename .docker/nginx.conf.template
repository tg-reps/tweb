server {
    listen 80;

    # Redirect bare base path to trailing-slash version
    location = ${BASE_PATH} {
        return 301 ${BASE_PATH}/;
    }

    location ${BASE_PATH}/ {
        # Strip the base path prefix so $uri becomes /foo.js instead of /client/foo.js
        rewrite ^${BASE_PATH}/(.*)$ /$1 break;
        root /usr/share/nginx/html;
        try_files $uri $uri/ @spa;
    }

    # SPA fallback: unknown routes serve index.html
    location @spa {
        root /usr/share/nginx/html;
        rewrite ^ /index.html last;
    }
}
